# ==============================================================================
# Riva Agent - Sensitive Environment Variables (.env.example)
#
# Copy this file to .env and fill in your private secrets and tokens:
#   cp .env.example .env
#
# Keep .env private and NEVER commit it to source control (it is ignored in .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Riva MCP Server Authentication
# ------------------------------------------------------------------------------
# Secret token required by external clients (Cursor, Claude Desktop, OpenClaw)
# to authenticate with Riva's MCP server (`riva mcp serve`) over SSE / HTTP headers:
#   X-Riva-API-Key: your_mcp_api_key_here
#   Authorization: Bearer your_mcp_api_key_here
RIVA_MCP_API_KEY="your_mcp_api_key_here"
# Optional fallback for RIVA_MCP_API_KEY
# RIVA_API_KEY="your_mcp_api_key_here"

# ------------------------------------------------------------------------------
# 2. Upstream LLM Provider Credentials
# ------------------------------------------------------------------------------
# API key for the OpenAI-compatible LLM provider (OpenAI, Groq, OpenRouter, etc.).
# Only required if using PROVIDER=openai in config.yml (Ollama requires no key).
OPENAI_API_KEY="sk-proj-your_openai_or_groq_api_key_here"

# ------------------------------------------------------------------------------
# 3. External MCP Servers & Tool Credentials (Configured via `riva mcp add`)
# ------------------------------------------------------------------------------
# Secret integration token for the Notion MCP Server (`uvx mcp-server-notion`):
NOTION_API_KEY="secret_your_notion_api_key_here"

# Personal Access Token (PAT) for the GitHub MCP Server:
GITHUB_PERSONAL_ACCESS_TOKEN="ghp_your_github_token_here"

# API key for the Brave Search MCP Server:
BRAVE_API_KEY="BSA_your_brave_search_api_key_here"

# ------------------------------------------------------------------------------
# 4. Proactive Local Digest & E2EE Signal Recipient
# ------------------------------------------------------------------------------
# Private recipient phone number (in E.164 format, e.g. +1234567890) or Signal handle
# for receiving daily morning briefings via the OpenClaw Signal bridge.
RIVA_DIGEST_SIGNAL_RECIPIENT="+1234567890"
