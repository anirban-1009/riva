---
type: job
title: {{ job.title | yaml }}
company: {{ job.company | yaml }}
job_id: {{ job.id | yaml }}
status: {{ status | yaml }}
applied: {{ 'true' if status not in ['ToApply', 'Wishlist'] else 'false' }}
applied_at: {{ applied_at | yaml if applied_at else 'null' }}
score: {{ score.score }}
specialization: {{ specialization | yaml }}
location: {{ job.location | yaml }}
employment_type: {{ job.employment_type | yaml }}
seniority_level: {{ job.seniority_level | yaml }}
job_function: {{ job.job_function | yaml }}
industries: {{ job.industries | yaml }}
posted_date: {{ job.posted_date | yaml }}
added: {{ job.created_at | yaml }}
link: {{ job.link | yaml }}
{% if job.salary %}
salary: {{ job.salary | yaml }}
{% endif %}
candidate_experience_years: {{ resume.total_experience_years | yaml if resume.total_experience_years else 'null' }}
poc_name: {{ poc_name | yaml if poc_name else 'null' }}
poc_link: {{ poc_link | yaml if poc_link else 'null' }}
tags:
  - job
  - {{ specialization }}
---
