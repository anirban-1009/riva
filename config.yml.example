# Copy this file to config.yml (gitignored) and adjust as needed.
# Every key is optional; omitting one falls back to the default noted below.

# Which LLM backend to talk to: "ollama" (default - the production path,
# local-only, see docs/product-definition.md §3.1) or "openai" (any
# OpenAI-compatible API - OpenAI itself, Groq, OpenRouter, a self-hosted
# vLLM/LM Studio server or mlx_lm.server, etc). "openai" exists for
# evaluation/benchmarking only - measuring how far behind local quality is -
# not a production path, since requests can leave the machine. Configure it
# via the `openai:` section below.
provider: ollama

# When set, every /v1/chat/completions request uses this model regardless of
# what the client asks for. Leave unset to let each request pick its own
# model. Run `curl localhost:8085/v1/models` to see what's available.
model: gemma4:12b-mlx

# Only used when provider is "openai". Both keys are optional here and fall
# back to the OPENAI_BASE_URL / OPENAI_API_KEY env vars if omitted - keep
# api_key out of this file (env var only) if you'd rather not have a secret
# sitting in a config file, even a gitignored one.
# openai:
#   base_url: http://localhost:8081/v1   # e.g. a local mlx_lm.server
#   api_key: sk-...                      # only needed for a real hosted API

# Kill switch for the extended-thinking heuristic. false disables "think"
# entirely regardless of prompt content or model capability; true (default)
# leaves the per-request heuristic in reasoning.py in charge.
thinking: true

# When false, every /v1/chat/completions request is forced non-streaming
# regardless of the client's "stream" field. true (default) respects
# whatever the client asks for.
streaming: true
